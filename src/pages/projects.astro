---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import type { ImageMetadata } from 'astro';
import kompassIcon from '../assets/projects/kompass.png';

interface Project {
  name: string;
  description: string;
  meta: string;
  url: string;
  icon?: ImageMetadata;
}

const personalProjects: Project[] = [
  {
    name: 'Kompass',
    description:
      'A tooling suite for GPU kernel development — test, benchmark, and profile CUDA, Triton, and PyTorch implementations of the same operation side by side, gated on correctness and benchmarked against an achievable bandwidth roofline.',
    meta: 'Python · CUDA · Triton',
    url: 'https://github.com/RPegoud/kompass',
    // icon: kompassIcon,
  },
];

const openSourceProjects: Project[] = [
  {
    name: 'Stoix',
    description:
      'A research-friendly codebase for fast, end-to-end single-agent reinforcement learning in JAX. Contributed a Rainbow DQN implementation (Hessel et al., 2017).',
    meta: 'Python · JAX · 425★',
    url: 'https://github.com/EdanToledo/Stoix',
  },
  {
    name: 'Syllabus',
    description:
      'Synchronized curriculum learning for RL agents — portable curricula that plug into existing training loops. Contributed multi-agent learning curricula in PyTorch for the RLC 2025 paper.',
    meta: 'Python · 124★',
    url: 'https://github.com/RyanNavillus/Syllabus',
  },
];
---

<BaseLayout
  title="Projects — Ryan Pégoud"
  description="Personal projects and open-source contributions in GPU kernels and reinforcement learning."
>
  <SiteHeader />
  <main class="mx-auto max-w-2xl px-6 py-16">
    <header>
      <h1 class="font-display text-3xl font-medium text-ink">Projects</h1>
      <p class="mt-2 font-body text-ink-muted">
        A selection of personal projects and open-source contributions.
      </p>
    </header>

    <section class="mt-12">
      <h2 class="font-mono text-xs tracking-wide text-ink-muted uppercase">Personal Projects</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {personalProjects.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-mono text-xs tracking-wide text-ink-muted uppercase">
        Open Source Contributions
      </h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {openSourceProjects.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>
  </main>
</BaseLayout>
