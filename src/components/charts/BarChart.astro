---
/**
 * Static, server-rendered SVG bar chart — see LineChart.astro for why this
 * is plain SVG rather than a JS charting lib.
 */
interface Bar {
  label: string;
  value: number;
  color: 'baseline' | 'accent';
}

interface Props {
  bars: Bar[];
  yLabel: string;
  valueFormat?: (v: number) => string;
  width?: number;
  height?: number;
  caption?: string;
  wide?: boolean;
}

const {
  bars,
  yLabel,
  valueFormat = (v: number) => String(v),
  width = 480,
  height = 340,
  caption,
  wide = false,
} = Astro.props;

const COLOR_VAR: Record<Bar['color'], string> = {
  baseline: 'var(--ink-muted)',
  accent: 'var(--accent)',
};

const margin = { top: 24, right: 16, bottom: 40, left: 56 };
const innerW = width - margin.left - margin.right;
const innerH = height - margin.top - margin.bottom;

const maxVal = Math.max(...bars.map((b) => b.value)) * 1.1;
const yTicks = 5;
const yTickVals = Array.from({ length: yTicks }, (_, i) => (maxVal * i) / (yTicks - 1));
const sy = (v: number) => margin.top + innerH - (v / maxVal) * innerH;

const gap = 0.35; // fraction of band spent on gap
const bandW = innerW / bars.length;
const barW = bandW * (1 - gap);
---

<figure class={`chart-figure not-prose figure ${wide ? 'figure-wide' : 'figure-column'}`}>
  <svg viewBox={`0 0 ${width} ${height}`} class="w-full" role="img" aria-label={caption ?? yLabel}>
    {
      yTickVals.map((v) => (
        <line x1={margin.left} x2={width - margin.right} y1={sy(v)} y2={sy(v)} stroke="var(--rule)" stroke-width="1" />
      ))
    }
    <line x1={margin.left} x2={margin.left} y1={margin.top} y2={margin.top + innerH} stroke="var(--ink-muted)" stroke-width="1" />
    <line x1={margin.left} x2={width - margin.right} y1={margin.top + innerH} y2={margin.top + innerH} stroke="var(--ink-muted)" stroke-width="1" />

    {
      yTickVals.map((v) => (
        <text x={margin.left - 8} y={sy(v)} text-anchor="end" dominant-baseline="middle" class="chart-tick">
          {valueFormat(v)}
        </text>
      ))
    }

    <text x={-(margin.top + innerH / 2)} y={14} text-anchor="middle" transform="rotate(-90)" class="chart-axis-label">
      {yLabel}
    </text>

    {
      bars.map((b, i) => {
        const x = margin.left + i * bandW + (bandW - barW) / 2;
        const y = sy(b.value);
        const h = margin.top + innerH - y;
        return (
          <>
            <rect x={x} y={y} width={barW} height={h} fill={COLOR_VAR[b.color]} />
            <text x={x + barW / 2} y={y - 8} text-anchor="middle" class="chart-value-label">
              {valueFormat(b.value)}
            </text>
            <text x={x + barW / 2} y={margin.top + innerH + 20} text-anchor="middle" class="chart-tick">
              {b.label}
            </text>
          </>
        );
      })
    }
  </svg>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chart-figure {
    border: 1px solid var(--rule);
    padding: 1.25rem 1.25rem 1rem;
  }
  .chart-tick {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--ink-muted);
  }
  .chart-value-label {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    fill: var(--ink);
  }
  .chart-axis-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    fill: var(--ink-muted);
    text-transform: uppercase;
  }
</style>
